# base de datos (obligatorias, sin esto Postgres no levanta)
DB_NAME=canchas
DB_USER=canchas
DB_PASSWORD=cambiar
DB_HOST=localhost

# backend
JWT_SECRET=cambiar

# Contraseña de los usuarios que crean los seeders
ADMIN_PASSWORD=cambiar_en_local

# puertos (opcionales, si no se definen se usan los por defecto)
DB_PORT=5433
BACKEND_PORT=3001
FRONTEND_PORT=5173
ADMINER_PORT=8080
